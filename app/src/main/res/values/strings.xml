    <!-- About -->
    <string name="about_tagline">A quiet stopwatch for the medicine you have to remember.</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_how_title">How reminders work</string>
    <string name="about_how_body">Jurah arms one exact alarm for your next dose, and arms the following one each time it fires. Reminders are re-armed after a restart, so a course keeps running.</string>
    <string name="about_accessibility_title">Accessibility</string>
    <string name="about_accessibility_body">Every action has a screen-reader label, text follows your system font size, and the layout mirrors fully in Arabic.</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy_body">Everything stays on this device. Jurah has no account, no network permission and no analytics.</string>
